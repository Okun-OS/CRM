# ── Database ───────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma Migrate and the pg driver adapter.
#
# ACHTUNG: Der folgende Wert ist ein Platzhalter für die lokale Entwicklung.
# Niemals so in eine Hosting-Plattform übernehmen — dort ist "localhost" der
# Container der Anwendung selbst, nicht die Datenbank. Auf Railway stattdessen
# auf den Datenbankdienst verweisen: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/okun_crm"

# ── Application ────────────────────────────────────────────────────────
# Public base URL of the deployment (used for invitation and webhook links).
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Secrets (generate with: openssl rand -base64 32) ───────────────────
# Signs session cookies. Rotating it invalidates all sessions.
SESSION_SECRET=""
# AES-256-GCM key for integration credentials at rest. Rotating it makes
# stored integration secrets unreadable — re-connect integrations afterwards.
ENCRYPTION_KEY=""

# ── File storage ───────────────────────────────────────────────────────
# "local" writes to STORAGE_LOCAL_PATH. Files are only served through the
# authenticated /api/v1/files/:id/content route, never from a public URL.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# ── Optional ───────────────────────────────────────────────────────────
# Trust X-Forwarded-For (set to "1" only behind a trusted proxy).
TRUST_PROXY="0"

# ── Postausgang des Betriebs (Einladungen) ─────────────────────────────
# Resend (empfohlen): API-Schlüssel aus resend.com → API Keys. MAIL_FROM muss
# auf einer in Resend bestätigten Domain liegen. Ohne diese Werte werden
# Einladungslinks angezeigt statt verschickt.
# RESEND_API_KEY=re_...
# MAIL_FROM=einladung@example.com
# MAIL_FROM_NAME=OKUN CRM
