// ───────────────────── Custom properties (EAV) ─────────────────────

model PropertyDefinition {
  id             String        @id @default(cuid())
  organizationId String
  objectType     CrmObjectType
  key            String
  label          String
  description    String?
  type           PropertyType
  /// For SELECT / MULTISELECT: [{ value, label }]
  options        Json?
  isRequired     Boolean       @default(false)
  isSystem       Boolean       @default(false)
  isArchived     Boolean       @default(false)
  groupName      String?
  position       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values         PropertyValue[]

  @@unique([organizationId, objectType, key])
  @@index([organizationId, objectType, position])
}

/// Typed EAV storage. Values live in the column matching the definition's type,
/// which keeps range filters, sorting and indexing possible — a single JSON
/// column would not. `valueJson` is only used for MULTISELECT.
model PropertyValue {
  id             String        @id @default(cuid())
  organizationId String
  definitionId   String
  objectType     CrmObjectType
  contactId      String?
  companyId      String?
  leadId         String?
  dealId         String?
  valueText      String?
  valueNumber    Decimal?      @db.Decimal(18, 4)
  valueBoolean   Boolean?
  valueDate      DateTime?
  valueJson      Json?
  updatedAt      DateTime      @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  definition     PropertyDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  contact        Contact?           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company        Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead           Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal           Deal?              @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([definitionId, contactId])
  @@unique([definitionId, companyId])
  @@unique([definitionId, leadId])
  @@unique([definitionId, dealId])
  @@index([organizationId, objectType])
  @@index([definitionId, valueText])
  @@index([definitionId, valueNumber])
  @@index([definitionId, valueDate])
}

// ───────────────────── Views, workflows, files ─────────────────────

model SavedView {
  id             String        @id @default(cuid())
  organizationId String
  objectType     CrmObjectType
