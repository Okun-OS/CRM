// OKUN CRM — Data model
// Product of OKUN Software. All tenant data is scoped by organizationId.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES
  USER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum CrmObjectType {
  CONTACT
  COMPANY
  LEAD
  DEAL
}

enum PropertyType {
  TEXT
  TEXTAREA
  NUMBER
  CURRENCY
  DATE
  DATETIME
  BOOLEAN
  SELECT
  MULTISELECT
  URL
  EMAIL
  PHONE
}

enum StageType {
  OPEN
  WON
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
  SYSTEM
}

enum ActivitySource {
  MANUAL
  SYSTEM
  WORKFLOW
  IMPORT
}

enum ActivityDirection {
  INBOUND
  OUTBOUND
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
  RECEIVED
}

enum IntegrationProvider {
  SMTP
  GOOGLE
  MICROSOFT
  SLACK
  STRIPE
  CALENDLY
  ZAPIER
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
  DISABLED
}

enum WorkflowTriggerType {
  RECORD_CREATED
  PROPERTY_CHANGED
  DEAL_STAGE_CHANGED
  LEAD_STATUS_CHANGED
  TASK_OVERDUE
}

enum WorkflowExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE
  DEAL_ASSIGNED
  MEETING_UPCOMING
  MENTION
  WORKFLOW_FAILED
  IMPORT_COMPLETED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum ImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum DuplicateStrategy {
  SKIP
  UPDATE
  CREATE_ANYWAY
}

// ───────────────────── Active CRM ─────────────────────

/// What a record is currently waiting for. Separate from the pipeline stage:
/// the stage says where a deal stands, this says what has to happen with it.
enum OperationalState {
  WAITING_FOR_US
  WAITING_FOR_CUSTOMER
  SCHEDULED
  NO_NEXT_ACTION
  CLOSED
}

enum NextActionType {
  CONTACT_LEAD
  QUALIFY_LEAD
  FOLLOW_UP
  CALL
  SCHEDULE_MEETING
  CONFIRM_MEETING
  PREPARE_MEETING
  CREATE_OFFER
  SEND_OFFER
  CHASE_OFFER
  GET_DECISION
  PREPARE_CONTRACT
  REACTIVATE
  DEFINE_NEXT_STEP
  CUSTOM
}

enum NextActionStatus {
  OPEN
  DONE
  DISMISSED
  SUPERSEDED
  SNOOZED
}

/// Momentum is derived from visible signals, never from an invented probability.
enum Momentum {
  HIGH
  MEDIUM
  LOW
  STALLED
}

enum AutomationType {
  FOLLOW_UP_EMAIL
  FOLLOW_UP_TASK
  RECALL
  REMINDER
}

enum AutomationStatus {
  PENDING
  EXECUTED
  SKIPPED
  CANCELLED
  FAILED
}

enum EventSource {
  USER
  SYSTEM
  AUTOMATION
  INTEGRATION
}

/// The business events the CRM reacts to. Everything that changes a record's
/// operational state passes through one of these.
enum CrmEventType {
  CONTACT_CREATED
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  DEAL_UPDATED
  EMAIL_SENT
  EMAIL_RECEIVED
  CALL_LOGGED
  NOTE_ADDED
  MEETING_BOOKED
  MEETING_COMPLETED
  MEETING_CANCELLED
  OFFER_CREATED
  OFFER_SENT
  OFFER_VIEWED
  CUSTOMER_REPLIED
  TASK_CREATED
  TASK_COMPLETED
  CONTRACT_SENT
  CONTRACT_ACCEPTED
  PAYMENT_RECEIVED
  DEAL_WON
  DEAL_LOST
  NEXT_ACTION_COMPLETED
  NEXT_ACTION_SNOOZED
  AUTOMATION_EXECUTED
  AUTOMATION_CANCELLED
  RECALL_REQUESTED
}

// ───────────────────── Tenancy, identity, access ─────────────────────

model Organization {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  domain                String?
  industry              String?
  locale                String    @default("de-DE")
  timezone              String    @default("Europe/Berlin")
  currency              String    @default("EUR")
  /// White-label preparation: brand overrides resolved on top of the OKUN defaults.
  brandConfig           Json?
  onboardingCompletedAt DateTime?
  /// Betreiber-Backoffice: stillgelegte Organisationen bleiben vollständig
  /// erhalten, ihre Mitglieder können sich aber nicht mehr anmelden.
  suspendedAt           DateTime?
  suspendedReason       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  memberships           Membership[]
  teams                 Team[]
  invitations           Invitation[]
  contacts              Contact[]
  companies             Company[]
  leads                 Lead[]
  deals                 Deal[]
  pipelines             Pipeline[]
  pipelineStages        PipelineStage[]
  dealStageHistory      DealStageHistory[]
  dealLineItems         DealLineItem[]
  dealContacts          DealContact[]
  activities            Activity[]
  tasks                 Task[]
  notes                 Note[]
  meetings              Meeting[]
  meetingAttendees      MeetingAttendee[]
  propertyDefinitions   PropertyDefinition[]
  propertyValues        PropertyValue[]
  savedViews            SavedView[]
  workflows             Workflow[]
  workflowExecutions    WorkflowExecution[]
  files                 FileObject[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  emailTemplates        EmailTemplate[]
  emailMessages         EmailMessage[]
  integrations          IntegrationConnection[]
  webhookEndpoints      WebhookEndpoint[]
  webhookDeliveries     WebhookDelivery[]
  lifecycleStages       LifecycleStageOption[]
  leadStatuses          LeadStatusOption[]
  tags                  Tag[]
  importJobs            ImportJob[]
  sessions              Session[]
  domainEvents          DomainEventRecord[]
  nextActions           NextAction[]
  automations           ScheduledAutomation[]
  apiKeys               ApiKey[]
  activeCrmSetting      ActiveCrmSetting?
  activeCrmRules        ActiveCrmRuleSetting[]

  @@index([deletedAt])
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  avatarUrl         String?
  locale            String    @default("de-DE")
  timezone          String    @default("Europe/Berlin")
  /// Encrypted TOTP secret — 2FA architecture is prepared, enrolment ships later.
  twoFactorSecret   String?
  twoFactorEnabledAt DateTime?
  lastLoginAt       DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  /// Betreiber-Ebene (OKUN Software), bewusst getrennt von den Rollen
  /// innerhalb einer Organisation: Sie erlaubt die Verwaltung von Mandanten,
  /// aber keinen Zugriff auf deren CRM-Daten.
  isPlatformAdmin   Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  memberships       Membership[]
  sessions          Session[]
  platformAuditLogs PlatformAuditLog[] @relation("PlatformAuditActor")
  ownedContacts     Contact[]      @relation("ContactOwner")
  createdContacts   Contact[]      @relation("ContactCreator")
  ownedCompanies    Company[]      @relation("CompanyOwner")
  createdCompanies  Company[]      @relation("CompanyCreator")
  ownedLeads        Lead[]         @relation("LeadOwner")
  ownedDeals        Deal[]         @relation("DealOwner")
  ownedTasks        Task[]         @relation("TaskOwner")
  createdTasks      Task[]         @relation("TaskCreator")
  ownedMeetings     Meeting[]      @relation("MeetingOwner")
  meetingAttendance MeetingAttendee[]
  notes             Note[]
  noteRevisions     NoteRevision[]
  activities        Activity[]
  files             FileObject[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  savedViews        SavedView[]
  workflows         Workflow[]
  emailTemplates    EmailTemplate[]
  emailMessages     EmailMessage[]
  integrations      IntegrationConnection[]
  webhookEndpoints  WebhookEndpoint[]
  importJobs        ImportJob[]
  invitationsSent   Invitation[]
  dealStageChanges  DealStageHistory[]
  domainEvents      DomainEventRecord[]
  ownedNextActions  NextAction[]        @relation("NextActionOwner")
  completedNextActions NextAction[]     @relation("NextActionCompleter")
  ownedAutomations  ScheduledAutomation[] @relation("AutomationOwner")
  createdAutomations ScheduledAutomation[] @relation("AutomationCreator")
  apiKeys           ApiKey[]
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           Role             @default(USER)
  status         MembershipStatus @default(ACTIVE)
  teamId         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId])
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  parentTeamId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentTeam     Team?        @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  childTeams     Team[]       @relation("TeamHierarchy")
  memberships    Membership[]
  emailTemplates EmailTemplate[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           Role         @default(USER)
  tokenHash      String       @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

model Session {
  id                    String       @id @default(cuid())
  /// SHA-256 of the opaque session token. The raw token only ever lives in the cookie.
  tokenHash             String       @unique
  userId                String
  activeOrganizationId  String?
  csrfToken             String
  ip                    String?
  userAgent             String?
  expiresAt             DateTime
  lastSeenAt            DateTime     @default(now())
  revokedAt             DateTime?
  createdAt             DateTime     @default(now())

  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization    Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

// ───────────────────── Configurable CRM vocabulary ─────────────────────

model LifecycleStageOption {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  label          String
  position       Int          @default(0)
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, position])
}

model LeadStatusOption {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  label          String
  position       Int          @default(0)
  isSystem       Boolean      @default(false)
  isTerminal     Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, position])
}

model Tag {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  color          String       @default("#2563EB")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       ContactTag[]
  companies      CompanyTag[]
  deals          DealTag[]

  @@unique([organizationId, name])
}

// ───────────────────────────── CRM objects ─────────────────────────────

model Company {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  domain         String?
  industry       String?
  employeeCount  Int?
  annualRevenue  Decimal?     @db.Decimal(14, 2)
  phone          String?
  email          String?
  website        String?
  street         String?
  postalCode     String?
  city           String?
  country        String?
  lifecycleStage String?
  source         String?
  description    String?
  ownerId        String?
  createdById    String?
  lastActivityAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("CompanyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contacts       Contact[]
  leads          Lead[]
  deals          Deal[]
  activities     Activity[]
  tasks          Task[]
  notes          Note[]
  meetings       Meeting[]
  files          FileObject[]
  emailMessages  EmailMessage[]
  tags           CompanyTag[]
  propertyValues PropertyValue[]
  domainEvents   DomainEventRecord[]
  nextActions    NextAction[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, name])
  @@index([organizationId, domain])
  @@index([organizationId, ownerId])
  @@index([organizationId, createdAt])
}

model CompanyTag {
  companyId String
  tagId     String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  mobile         String?
  jobTitle       String?
  companyId      String?
  lifecycleStage String?
  leadStatus     String?
  source         String?
  street         String?
  postalCode     String?
  city           String?
  country        String?
  linkedinUrl    String?
  description    String?
  ownerId        String?
  createdById    String?
  lastActivityAt DateTime?
  nextActivityAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner          User?        @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("ContactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  leads          Lead[]
  dealContacts   DealContact[]
  activities     Activity[]
  tasks          Task[]
  notes          Note[]
  meetings       Meeting[]
  meetingAttendance MeetingAttendee[]
  files          FileObject[]
  emailMessages  EmailMessage[]
  tags           ContactTag[]
  propertyValues PropertyValue[]
  domainEvents   DomainEventRecord[]
  nextActions    NextAction[]
  automations    ScheduledAutomation[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, email])
  @@index([organizationId, ownerId])
  @@index([organizationId, companyId])
  @@index([organizationId, createdAt])
  @@index([organizationId, lifecycleStage])
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model Lead {
  id                 String       @id @default(cuid())
  organizationId     String
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  companyName        String?
  jobTitle           String?
  source             String?
  status             String
  score              Int?
  qualification      String?
  nextStepAt         DateTime?
  lastActivityAt     DateTime?
  ownerId            String?
  contactId          String?
  companyId          String?
  convertedAt        DateTime?
  convertedContactId String?
  convertedCompanyId String?
  convertedDealId    String?

  /// Active CRM: what has to happen next, and what the record is waiting for.
  operationalState   OperationalState @default(NO_NEXT_ACTION)
  nextActionAt       DateTime?
  nextActionType     NextActionType?
  nextActionTitle    String?
  momentum           Momentum         @default(MEDIUM)
  /// The signals behind the momentum value, so the user can see the reasoning.
  momentumSignals    Json?
  lastOutboundAt     DateTime?
  lastCustomerResponseAt DateTime?
  nextMeetingAt      DateTime?
  stalledSince       DateTime?
  /// Manual override: automation is paused for this record until then.
  automationPausedUntil  DateTime?
  automationPausedReason String?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner              User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contact            Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company            Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  activities         Activity[]
  tasks              Task[]
  notes              Note[]
  propertyValues     PropertyValue[]
  domainEvents       DomainEventRecord[]
  nextActions        NextAction[]
  automations        ScheduledAutomation[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([organizationId, operationalState, nextActionAt])
  @@index([organizationId, ownerId])
  @@index([organizationId, createdAt])
  @@index([organizationId, email])
}

model Pipeline {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean         @default(false)
  position       Int             @default(0)
  isArchived     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         PipelineStage[]
  deals          Deal[]

  @@unique([organizationId, name])
  @@index([organizationId, position])
}

model PipelineStage {
  id             String       @id @default(cuid())
  organizationId String
  pipelineId     String
  key            String
  name           String
  position       Int          @default(0)
  probability    Int          @default(0)
  type           StageType    @default(OPEN)
  /// Active CRM: what the system should propose for a deal sitting in this
  /// stage, and after how many days without progress it becomes due.
  expectedAction     NextActionType?
  expectedActionDays Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals          Deal[]
  historyFrom    DealStageHistory[] @relation("StageFrom")
  historyTo      DealStageHistory[] @relation("StageTo")

  @@unique([pipelineId, key])
  @@index([organizationId, pipelineId, position])
}

model Deal {
  id                String       @id @default(cuid())
  organizationId    String
  name              String
  companyId         String?
  pipelineId        String
  stageId           String
  amount            Decimal      @default(0) @db.Decimal(14, 2)
  currency          String       @default("EUR")
  probability       Int?
  status            DealStatus   @default(OPEN)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  source            String?
  description       String?
  ownerId           String?
  lastActivityAt    DateTime?

  /// Active CRM: the operational state next to the pipeline stage.
  operationalState  OperationalState @default(NO_NEXT_ACTION)
  nextActionAt      DateTime?
  nextActionType    NextActionType?
  nextActionTitle   String?
  momentum          Momentum         @default(MEDIUM)
  momentumSignals   Json?
  stageEnteredAt    DateTime?
  offerSentAt       DateTime?
  lastOutboundAt    DateTime?
  lastCustomerResponseAt DateTime?
  nextMeetingAt     DateTime?
  stalledSince      DateTime?
  /// Manual override: automation is paused for this record until then.
  automationPausedUntil  DateTime?
  automationPausedReason String?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pipeline          Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage             PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner             User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts          DealContact[]
  lineItems         DealLineItem[]
  stageHistory      DealStageHistory[]
  activities        Activity[]
  tasks             Task[]
  notes             Note[]
  meetings          Meeting[]
  files             FileObject[]
  emailMessages     EmailMessage[]
  tags              DealTag[]
  propertyValues    PropertyValue[]
  domainEvents      DomainEventRecord[]
  nextActions       NextAction[]
  automations       ScheduledAutomation[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, operationalState, nextActionAt])
  @@index([organizationId, momentum])
  @@index([organizationId, stageId])
  @@index([organizationId, pipelineId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, expectedCloseDate])
  @@index([organizationId, createdAt])
}

model DealTag {
  dealId String
  tagId  String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
}

model DealContact {
  dealId         String
  contactId      String
  organizationId String
  role           String?
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([dealId, contactId])
  @@index([organizationId, contactId])
}

model DealLineItem {
  id             String       @id @default(cuid())
  organizationId String
  dealId         String
  name           String
  description    String?
  quantity       Decimal      @default(1) @db.Decimal(12, 2)
  unitPrice      Decimal      @default(0) @db.Decimal(14, 2)
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, dealId])
}

model DealStageHistory {
  id              String        @id @default(cuid())
  organizationId  String
  dealId          String
  fromStageId     String?
  toStageId       String
  changedById     String?
  changedAt       DateTime      @default(now())
  durationSeconds Int?

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal            Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage       PipelineStage? @relation("StageFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage         PipelineStage  @relation("StageTo", fields: [toStageId], references: [id], onDelete: Cascade)
  changedBy       User?          @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([organizationId, dealId, changedAt])
}

// ───────────────────── Engagement: activities, tasks, notes, meetings ─────────────────────

model Activity {
  id              String            @id @default(cuid())
  organizationId  String
  type            ActivityType
  source          ActivitySource    @default(MANUAL)
  subject         String?
  body            String?
  direction       ActivityDirection?
  outcome         String?
  durationMinutes Int?
  occurredAt      DateTime          @default(now())
  metadata        Json?
  actorId         String?
  contactId       String?
  companyId       String?
  dealId          String?
  leadId          String?
  taskId          String?
  meetingId       String?
  noteId          String?
  emailMessageId  String?
  createdAt       DateTime          @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor           User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal            Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  task            Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  meeting         Meeting?      @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  note            Note?         @relation(fields: [noteId], references: [id], onDelete: SetNull)
  emailMessage    EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, type, occurredAt])
  @@index([contactId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([dealId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([organizationId, actorId, occurredAt])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         TaskStatus   @default(OPEN)
  priority       TaskPriority @default(MEDIUM)
  dueAt          DateTime?
  remindAt       DateTime?
  completedAt    DateTime?
  ownerId        String?
  createdById    String?
  contactId      String?
  companyId      String?
  dealId         String?
  leadId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?        @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  activities     Activity[]
  nextActions    NextAction[]

  @@index([organizationId, status, dueAt])
  @@index([organizationId, ownerId, status])
  @@index([contactId])
  @@index([dealId])
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
