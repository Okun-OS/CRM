  @@index([organizationId, createdAt])
}


// ───────────────────── Active CRM: events, next actions, automation ─────────────────────

/// Append-only event log. Every business event is recorded once (idempotency
/// key) and then dispatched to the engines. It is the audit trail of *why* the
/// CRM did something, and the integration surface for OKUN Deals.
/// Per-organization thresholds for the Next Action engine. Every number the
/// engine uses is configurable here — nothing is hardcoded in the rules.
model ActiveCrmSetting {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  /// Master switch: off means the engine still proposes, but never executes.
  automationEnabled      Boolean  @default(true)
  /// Hours a new lead may stay untouched before contacting it becomes due.
  leadContactWithinHours Int      @default(24)
  /// Days after an outbound message without a reply before a follow-up is due.
  followUpAfterDays      Int      @default(3)
  /// Days after an offer was sent before chasing it becomes due.
  offerChaseAfterDays    Int      @default(5)
  /// Days without any activity before a record counts as stalled.
  stagnationAfterDays    Int      @default(14)
  /// Hours before a meeting at which preparing it becomes due.
  meetingPrepLeadHours   Int      @default(24)
  /// Days after a completed meeting without a next step before it becomes due.
  meetingFollowUpDays    Int      @default(2)
  /// Only inside these hours may an automation send anything outbound.
  quietHoursStart        Int      @default(20)
  quietHoursEnd          Int      @default(7)
  /// Outbound automations send only on working days when true.
  workdaysOnly           Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Per-organization override for a single rule of the catalogue: switch it off
/// or shift its due date, without changing code.
model ActiveCrmRuleSetting {
  id             String   @id @default(cuid())
  organizationId String
  ruleKey        String
  isEnabled      Boolean  @default(true)
  /// Overrides the rule's own delay, in days.
  delayDays      Int?
  /// Overrides the rule's priority (0–100, higher is more urgent).
  priority       Int?
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, ruleKey])
}

/// Protokoll der Betreiber-Ebene. Bewusst getrennt vom AuditLog der
/// Organisationen: Dessen Einträge gehören dem jeweiligen Mandanten, diese
/// hier gehören dem Betreiber und überdauern eine gelöschte Organisation.
model PlatformAuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorEmail     String
  action         String
  /// Betroffene Organisation, sofern die Aktion eine betrifft.
  organizationId String?
  organizationName String?
  details        Json?
  ip             String?
  createdAt      DateTime @default(now())

  actor          User?    @relation("PlatformAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([organizationId, createdAt])
}

model DomainEventRecord {
  id             String       @id @default(cuid())
  organizationId String
  type           CrmEventType
  source         EventSource  @default(SYSTEM)
  /// Stable key per logical event; a repeated delivery is ignored.
  idempotencyKey String
  contactId      String?
  companyId      String?
  dealId         String?
  leadId         String?
  actorId        String?
  payload        Json?
  occurredAt     DateTime     @default(now())
  processedAt    DateTime?
  processingError String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, occurredAt])
  @@index([organizationId, type, occurredAt])
  @@index([dealId, occurredAt])
  @@index([leadId, occurredAt])
}

/// The one thing that has to happen next for a record. Produced by the rule
/// engine with a human-readable reason, or set by a person.
model NextAction {
  id             String           @id @default(cuid())
  organizationId String
  type           NextActionType
  status         NextActionStatus @default(OPEN)
  title          String
  /// Why the system proposes this — always shown to the user.
  reason         String
  /// Key of the rule that produced it; empty for manual actions.
  ruleKey        String?
  isManual       Boolean          @default(false)
  dueAt          DateTime?
  snoozedUntil   DateTime?
  priority       Int              @default(50)
  ownerId        String?
  contactId      String?
  companyId      String?
  dealId         String?
  leadId         String?
  taskId         String?
  completedAt    DateTime?
  completedById  String?
  dismissedAt    DateTime?
  dismissReason  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?        @relation("NextActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  completedBy    User?        @relation("NextActionCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([organizationId, ownerId, status, dueAt])
  @@index([dealId, status])
  @@index([leadId, status])
}

/// A scheduled follow-up. Guards are re-checked immediately before execution,
/// so a customer reply cancels the message instead of sending it anyway.
model ScheduledAutomation {
  id             String           @id @default(cuid())
  organizationId String
  type           AutomationType
  status         AutomationStatus @default(PENDING)
  scheduledFor   DateTime
  /// Human-readable reason, shown wherever the automation appears.
  reason         String
  ruleKey        String?
  /// Conditions re-checked before execution (see engine/guards.ts).
  guards         Json?
  payload        Json?
  dealId         String?
  leadId         String?
  contactId      String?
  ownerId        String?
  templateId     String?
  createdById    String?
  executedAt     DateTime?
  cancelledAt    DateTime?
  /// Why it was cancelled or skipped — never silent.
  outcomeReason  String?
  attempts       Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal           Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner          User?          @relation("AutomationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User?          @relation("AutomationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  template       EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, scheduledFor])
  @@index([dealId, status])
  @@index([leadId, status])
}

/// API credentials for machine-to-machine event ingestion (OKUN Deals and other
/// OKUN products). Only the hash is stored.
model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  /// First characters of the key, for recognising it in the UI.
  prefix         String
  keyHash        String       @unique
  scopes         String[]
  createdById    String?
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, revokedAt])
}
