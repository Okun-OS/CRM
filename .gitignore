# Abhängigkeiten (bewusst nicht verankert: pnpm legt verschachtelte Ordner an)
node_modules/

# Build-Artefakte — alle am Wurzelverzeichnis verankert, damit ein gleich
# benannter Ordner im Quellcode nicht versehentlich mit ignoriert wird.
/.next/
/out/
/build/
/dist/
/coverage/
/test-results/
/playwright-report/
next-env.d.ts
tsconfig.tsbuildinfo

# Generierter Prisma-Client (wird von `prisma generate` erzeugt)
/src/generated/

# Geheimnisse
.env
.env.local
.env.*.local

# Lokale Dateiablage (STORAGE_LOCAL_PATH) — verankert, sonst trifft das Muster
# auch src/server/storage/.
/storage/
/storage-test/
/storage-e2e/

# Sonstiges
*.log
.DS_Store
.vscode/
.idea/
